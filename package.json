{
  "name": "roc-lang-unofficial",
  "version": "0.1.1",
  "icon": "resources/roc-logo.png",
  "displayName": "Roc (Unofficial)",
  "description": "Roc language support",
  "publisher": "IvanDemchenko",
  "pricing": "Free",
  "license": "MIT",
  "author": {
    "name": "Ivan Demchenko",
    "email": "idemchenko.js@gmail.com"
  },
  "engines": {
    "vscode": "^1.97.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ivan-demchenko/roc-vscode-unofficial"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [],
  "main": "./dist/extension",
  "contributes": {
    "languages": [
      {
        "id": "roc",
        "aliases": ["Roc", "roc", "roc-lang"],
        "extensions": [".roc"],
        "configuration": "./roc-language-configuration.json",
        "icon": {
          "dark": "./resources/roc-logo.png",
          "light": "./resources/roc-logo.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "roc",
        "scopeName": "source.roc",
        "path": "./syntaxes/roc.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "roc",
        "scopes": {
          "namespace": ["entity.name.namespace"],
          "type": ["entity.name.type", "support.type"],
          "parameter": ["variable.parameter"],
          "variable": ["variable.other"],
          "property": ["variable.other.property"],
          "enumMember": ["variable.other.enummember", "constant.other.enum"],
          "function": ["entity.name.function"],
          "keyword": ["keyword.control", "keyword"],
          "string": ["string.quoted", "string"],
          "number": ["constant.numeric"],
          "operator": ["keyword.operator"],
          "comment": ["comment"]
        }
      }
    ],
    "commands": [
      {
        "command": "roc-lang-unofficial.ls-start",
        "title": "Start Language Server",
        "category": "Roc (unofficial)"
      },
      {
        "command": "roc-lang-unofficial.ls-stop",
        "title": "Stop Language Server",
        "category": "Roc (unofficial)"
      }
    ],
    "configuration": [
      {
        "type": "object",
        "title": "roc-lang",
        "properties": {
          "roc-lang.language-server.exe": {
            "type": "string",
            "description": "Path to the language server executable (e.g., /path/to/roc)"
          },
          "roc-lang.language-server.args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Arguments to pass to the language server (e.g., [\"experimental-lsp\", \"--debug-transport\"])"
          },
          "roc-lang.language-server.debug-exe": {
            "type": "string",
            "description": "Path to the debug language server executable"
          },
          "roc-lang.language-server.debug-args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Arguments for the debug language server"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "webpack --mode production",
    "dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "check": "tsc --noEmit && biome check ./src",
    "test": "pnpm run check",
    "prepare": "husky",
    "lint:code": "biome check --write ./src",
    "lint:commit": "commitlint --edit",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/changelog": "^6.0.3",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.97.0",
    "@vscode/vsce": "^3.9.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "semantic-release": "^24.2.9",
    "semantic-release-vsce": "^6.1.5",
    "ts-loader": "^9.6.2",
    "ts-results": "^3.3.0",
    "typescript": "^5.9.3",
    "webpack": "^5.108.0",
    "webpack-cli": "^5.1.4"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "vsce": {
    "dependencies": false
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "packageManager": "pnpm@8.14.1"
}
